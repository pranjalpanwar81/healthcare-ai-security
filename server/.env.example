# Free-tier Gemini setup for Ask AI and LangChain features. Keep the key server-side.
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Local TensorFlow symptom prediction service (start with PORT=5001)
LOCAL_ML_API_URL=http://127.0.0.1:5001

# Optional paid OpenAI setup instead:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini

# LangChain generative AI features use the configured provider above.
# Symptom Analyzer uses the local TensorFlow service at LOCAL_ML_API_URL.
# Available AI Agents:
# - Medical Record Summarization
# - Symptom Analysis
# - Drug Interaction Checker
# - Treatment Recommendations (Doctors only)
# - Medical Chatbot with Memory
# - Health Anomaly Detection
