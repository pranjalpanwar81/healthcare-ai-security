# Copy to server/.env for local overrides. Every value is optional in development.

# Required in production: 32 random bytes, base64. Locally a key is generated in server/data.
MASTER_KEY=

# Code hospital IT enters to register a new hospital Wi-Fi network.
HOSPITAL_ENROLL_CODE=

# Code required to create clinician accounts.
DOCTOR_REGISTRATION_CODE=

# Trusted hospital networks, comma-separated "cidr=Label", e.g. 203.0.113.7/32=Main Wi-Fi
HOSPITAL_NETWORKS=

# Initial account passwords as JSON, e.g. {"rohan@healthguard.demo":"..."}
SEED_PASSWORDS=

# Timezone used for out-of-hours alerts.
HOSPITAL_TIMEZONE=Asia/Kolkata

# Set by Vercel when a Blob store is linked; enables the shared data store.
BLOB_READ_WRITE_TOKEN=
