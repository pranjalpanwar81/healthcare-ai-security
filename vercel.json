{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "rewrites":  [
                     {
                         "source":  "/api/(.*)",
                         "destination":  "/api"
                     },
                     {
                         "source":  "/((?!assets/|favicon.svg).*)",
                         "destination":  "/index.html"
                     }
                 ],
    "headers":  [
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "DENY"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "no-referrer"
                                        },
                                        {
                                            "key":  "Strict-Transport-Security",
                                            "value":  "max-age=31536000; includeSubDomains"
                                        },
                                        {
                                            "key":  "Content-Security-Policy",
                                            "value":  "default-src \u0027self\u0027; script-src \u0027self\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 data:; font-src \u0027self\u0027 data:; connect-src \u0027self\u0027; frame-ancestors \u0027none\u0027; base-uri \u0027self\u0027; form-action \u0027self\u0027"
                                        }
                                    ]
                    }
                ],
    "functions":  {
                      "api/index.js":  {
                                           "includeFiles":  "server/models/**",
                                           "maxDuration":  30
                                       }
                  }
}